# Oyster360 native-backend environment template.
# Copy to backend/.env when running uvicorn or celery outside Docker.
# The repository-root .env.example is the equivalent for Docker Compose.

# PostgreSQL (or point at your own instance)
DATABASE_URL=postgresql://oyster360:oyster360_secure_pass@localhost:5432/oyster360

# Authentication (use a unique random value of at least 32 characters)
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Browser/API access
CORS_ORIGINS=http://localhost:3000

# Redis for cache and Celery
REDIS_URL=redis://localhost:6379/0

# AI provider: rule-based works without an external API key
AI_PROVIDER=rule-based
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe billing (optional for local farm-management development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Observability (optional; disabled when SENTRY_DSN is blank)
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
