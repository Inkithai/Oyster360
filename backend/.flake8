[flake8]
# Mirrors the backend CI step: fail on syntax errors and undefined names.
# Run locally with: flake8 app tests
max-line-length = 100
max-complexity = 10
show-source = true
count = true
exclude =
    .venv,
    __pycache__,
    alembic/versions,
    alembic/versions/*,
    backend/alembic/versions,
    backend/alembic/versions/*
