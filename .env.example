# Oyster360 local environment template
# Copy to .env for Docker Compose, and to backend/.env for native backend runs.

# Database
DB_USER=oyster360
DB_PASSWORD=oyster360_secure_pass
DB_NAME=oyster360
DATABASE_URL=postgresql://oyster360:oyster360_secure_pass@localhost:5432/oyster360

# Authentication (use a unique random value of at least 32 characters)
# SECRET_KEY is the canonical name; JWT_SECRET is accepted as an alias.
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Browser/API access
CORS_ORIGINS=http://localhost:3000

# Redis, Celery, and caching
REDIS_URL=redis://localhost:6379/0

# AI provider: rule-based works without an external API key
AI_PROVIDER=rule-based
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe billing (optional for local farm-management development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Observability (optional; disabled when SENTRY_DSN is blank)
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend observability: structured console logs always; client error
# reporting to a Sentry-compatible endpoint only when the DSN is set.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Frontend
# Leave NEXT_PUBLIC_API_URL empty to use the same-origin Next.js /api proxy.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://localhost:8000

# Optional future file storage integration
STORAGE_BUCKET=
