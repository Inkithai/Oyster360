# Oyster360 Environment Configuration

# Database
DATABASE_URL=postgresql://mycofarm_user:mycofarm_pass@localhost:5432/mycofarm

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI (Future)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=...

# Storage (Future)
STORAGE_BUCKET=myco-farm-images

# Stripe billing
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_STARTER=price_your-starter-price-id
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_ENTERPRISE=price_your-enterprise-price-id

# Frontend (leave empty to use the same-origin Next.js API proxy)
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://localhost:8000